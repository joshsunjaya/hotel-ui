@{
    ViewData["Title"] = "Hotel Niagara Lawang";
}

<section class="hero">
    <div class="hero-content">
        <div class="eyebrow">
            Hotel Niagara Lawang
        </div>

        <h1>
            A Timeless Stay in Lawang
        </h1>

        <p>
            Experience comfort, elegance, and the charm of Lawang
            in a place where classic hospitality meets modern living.
        </p>

        <div class="hero-buttons">
            <a href="#" class="btn-primary">
                Book Your Stay
            </a>

            <a href="#" class="btn-outline">
                Explore Rooms
            </a>
        </div>
    </div>
</section>

<div class="booking-wrapper">
    <div class="booking">

        <div class="booking-item">
            <label>Check In</label>
            <input type="date">
        </div>

        <div class="booking-item">
            <label>Check Out</label>
            <input type="date">
        </div>

        <div class="booking-item">
            <label>Guests</label>
            <select>
                <option>1 Guest</option>
                <option>2 Guests</option>
                <option>3 Guests</option>
                <option>4 Guests</option>
            </select>
        </div>

        <div class="booking-item">
            <label>Room</label>
            <select>
                <option>Any Room</option>
                <option>Standard</option>
                <option>Deluxe</option>
                <option>Suite</option>
            </select>
        </div>

        <button class="booking-button">
            Check Availability
        </button>

    </div>
</div>

<section class="intro">
    <div class="intro-image"></div>

    <div class="intro-content">
        <span class="section-label">
            Welcome to Niagara
        </span>

        <h2>
            Where comfort meets timeless elegance.
        </h2>

        <p>
            Located in the heart of Lawang, Hotel Niagara offers
            a unique hospitality experience surrounded by the
            beauty and atmosphere of East Java.
        </p>

        <p>
            Whether you're travelling for business, a family getaway,
            or simply looking for a peaceful escape, our rooms and
            services are designed to make your stay memorable.
        </p>

        <a href="#" class="read-more">
            Discover Our Story →
        </a>
    </div>
</section>

<section class="rooms">
    <div class="rooms-header">
        <span class="section-label">
            Stay With Us
        </span>

        <h2>
            Our Rooms & Suites
        </h2>
    </div>

    <div class="room-grid">

        <div class="room-card">
            <div class="room-image room-standard"></div>

            <div class="room-content">
                <h3>Standard Room</h3>
                <p>
                    A comfortable space designed for a relaxing
                    and enjoyable stay.
                </p>

                <div class="room-price">
                    From Rp 500.000 / night
                </div>
            </div>
        </div>

        <div class="room-card">
            <div class="room-image room-deluxe"></div>

            <div class="room-content">
                <h3>Deluxe Room</h3>
                <p>
                    More space, more comfort, and a refined
                    atmosphere for your stay.
                </p>

                <div class="room-price">
                    From Rp 750.000 / night
                </div>
            </div>
        </div>

        <div class="room-card">
            <div class="room-image room-suite"></div>

            <div class="room-content">
                <h3>Suite</h3>
                <p>
                    An elevated experience with generous space
                    and premium comfort.
                </p>

                <div class="room-price">
                    From Rp 1.500.000 / night
                </div>
            </div>
        </div>

    </div>
</section>