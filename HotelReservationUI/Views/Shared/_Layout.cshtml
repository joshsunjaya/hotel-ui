<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Hotel Niagara Lawang</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <!-- Header -->
    <header class="hotel-header">

        <nav class="navbar navbar-expand-lg hotel-navbar">

            <div class="container">

                <!-- Logo -->
                <a class="navbar-brand hotel-logo"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="hotel-logo-main">
                        HOTEL NIAGARA
                    </span>

                    <span class="hotel-logo-sub">
                        LAWANG
                    </span>

                </a>


                <!-- Mobile Toggle -->
                <button class="navbar-toggler hotel-navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- Navigation -->
                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav ms-auto align-items-lg-center hotel-nav">

                        <li class="nav-item">
                            <a class="nav-link hotel-nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link hotel-nav-link"
                               asp-controller="Room"
                               asp-action="Index">
                                Rooms
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link hotel-nav-link"
                               asp-controller="Facility"
                               asp-action="Index">
                                Facilities
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link hotel-nav-link"
                               asp-controller="About"
                               asp-action="Index">
                                About
                            </a>
                        </li>

                        <li class="nav-item ms-lg-4 mt-3 mt-lg-0">

                            <a class="nav-book"
                               asp-controller="Booking"
                               asp-action="Index">

                                <span>Book Your Stay</span>

                                <span class="nav-book-arrow">
                                    →
                                </span>

                            </a>

                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <!-- Main -->
    <main>
        @RenderBody()
    </main>


    <!-- Footer -->
    <footer class="hotel-footer">

        <div class="container">

            <div class="footer-inner">

                <div class="footer-brand">

                    <span class="section-label">
                        HOTEL NIAGARA LAWANG
                    </span>

                    <h3>
                        Stay. Relax.<br />
                        Experience Lawang.
                    </h3>

                    <p>
                        A comfortable stay surrounded by
                        the charm of Lawang, East Java.
                    </p>

                </div>


                <div class="footer-info">

                    <span class="footer-info-label">
                        CONTACT
                    </span>

                    <strong>
                        Hotel Niagara Lawang
                    </strong>

                    <p>
                        Lawang, East Java, Indonesia<br />
                        +62 341 426612<br />
                        hotelniagara1@gmail.com
                    </p>

                </div>

            </div>


            <div class="footer-bottom">

                <span>
                    © 2026 Hotel Niagara Lawang
                </span>

                <span>
                    All rights reserved.
                </span>

            </div>

        </div>

    </footer>


    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
