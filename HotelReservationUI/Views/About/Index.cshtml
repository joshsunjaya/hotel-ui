@{
    ViewData["Title"] = "About Us";
}

<section class="about-page">

    <!-- Hero -->
    <section class="about-hero">
        <div class="container">

            <div class="about-hero-content">

                <span class="section-label">
                    ABOUT HOTEL NIAGARA
                </span>

                <h1>
                    A Historic Stay
                    <br />
                    <span>in the Heart of Lawang</span>
                </h1>

                <p>
                    Experience the charm of Hotel Niagara Lawang,
                    where heritage, comfort, and the beauty of East Java
                    come together.
                </p>

            </div>

        </div>
    </section>


    <!-- Introduction -->
    <section class="about-introduction">

        <div class="container">

            <div class="about-introduction-grid">

                <div class="about-introduction-image">

                    <img src="/images/about/hotel-niagara.avif"
                         alt="Hotel Niagara Lawang" />

                </div>


                <div class="about-introduction-content">

                    <span class="section-label">
                        OUR STORY
                    </span>

                    <h2>
                        Where Heritage
                        <br />
                        Meets Comfort
                    </h2>

                    <p>
                        Hotel Niagara Lawang is a historic hotel located
                        in Lawang, East Java. Surrounded by the natural
                        beauty of the region, the hotel offers guests
                        a unique experience combining classic charm
                        with comfortable accommodation.
                    </p>

                    <p>
                        Whether you are visiting for a relaxing getaway,
                        a family trip, or a business stay, Hotel Niagara
                        Lawang provides a welcoming environment where
                        guests can enjoy their time in East Java.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- Experience -->
    <section class="about-experience">

        <div class="container">

            <div class="section-heading">

                <span class="section-label">
                    THE EXPERIENCE
                </span>

                <h2>
                    Stay Somewhere Special
                </h2>

                <p>
                    More than just a place to stay, we offer an experience
                    surrounded by history, nature, and local charm.
                </p>

            </div>


            <div class="about-experience-grid">

                <div class="about-experience-card">

                    <div class="about-experience-number">
                        01
                    </div>

                    <h3>
                        Historic Charm
                    </h3>

                    <p>
                        Discover the distinctive character and timeless
                        atmosphere of a historic hotel in Lawang.
                    </p>

                </div>


                <div class="about-experience-card">

                    <div class="about-experience-number">
                        02
                    </div>

                    <h3>
                        Natural Surroundings
                    </h3>

                    <p>
                        Enjoy a peaceful atmosphere surrounded by the
                        natural beauty of East Java.
                    </p>

                </div>


                <div class="about-experience-card">

                    <div class="about-experience-number">
                        03
                    </div>

                    <h3>
                        Comfortable Stay
                    </h3>

                    <p>
                        Relax in a comfortable environment with facilities
                        designed to make your stay enjoyable.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- Location -->
    <section class="about-location">

        <div class="container">

            <div class="about-location-grid">

                <div class="about-location-content">

                    <span class="section-label">
                        OUR LOCATION
                    </span>

                    <h2>
                        Discover Lawang
                    </h2>

                    <p>
                        Located in Lawang, East Java, Hotel Niagara
                        provides a convenient base for exploring the
                        surrounding area and enjoying the atmosphere
                        of the region.
                    </p>

                    <div class="about-location-info">

                        <div>
                            <strong>Location</strong>
                            <span>
                                Lawang, East Java, Indonesia
                            </span>
                        </div>

                        <div>
                            <strong>Phone</strong>
                            <span>
                                +62341 426612
                            </span>
                        </div>

                        <div>
                            <strong>Email</strong>
                            <span>
                                hotelniagara1@gmail.com
                            </span>
                        </div>

                    </div>

                </div>


                <div class="about-location-map">

                    <div class="about-map-placeholder">
                        <span>
                            Hotel Niagara Lawang
                        </span>

                        <small>
                            Lawang, East Java, Indonesia
                        </small>
                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- CTA -->
    <section class="about-cta">

        <div class="container">

            <div class="about-cta-content">

                <span class="section-label">
                    PLAN YOUR STAY
                </span>

                <h2>
                    Experience Hotel Niagara Lawang
                </h2>

                <p>
                    Discover our rooms and facilities and make
                    your stay in Lawang a memorable one.
                </p>

                <a asp-controller="Room"
                   asp-action="Index"
                   class="about-cta-button">
                    Explore Our Rooms
                </a>

            </div>

        </div>

    </section>

</section>